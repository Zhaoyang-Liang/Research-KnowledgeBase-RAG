# ============================================================
# Embedding Provider 配置
# ============================================================
# 支持的 provider:
#   siliconflow  - 硅基流动 (BGE-large-zh-v1.5)       推荐
#   dashscope     - 阿里百炼 (text-embedding-v3)
#   zhipu         - 智谱AI (embedding-2)
#   openai        - OpenAI (text-embedding-3-small)

EMBEDDING_PROVIDER=siliconflow

# API Key（根据 provider 填写对应的 key）
#   硅基流动: https://cloud.siliconflow.cn/account/ak
#   阿里百炼: https://bailian.console.aliyun.com/
#   智谱AI:   https://open.bigmodel.cn/
EMBEDDING_API_KEY=sk-your-key-here

# Embedding 模型（可选，不填则使用 provider 默认模型）
#   siliconflow 默认: Pro/BAAI/bge-m3
#   中文优化备选:   BAAI/bge-large-zh-v1.5
# EMBEDDING_MODEL=Pro/BAAI/bge-m3

# ============================================================
# 各 provider 价格参考 (¥/1M tokens)
#   siliconflow BGE-large-zh   ¥0.70
#   siliconflow BGE-M3         ¥1.40
#   dashscope   text-embedding ¥0.70
#   zhipu       embedding-2    ¥0.50
#   openai      text-embed-3   $0.02 (~¥0.14)
# ============================================================
